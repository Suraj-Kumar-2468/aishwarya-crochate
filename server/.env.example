PORT=4000

# Leave unset to use an in-memory dev database (data resets every restart).
# Set to a real MongoDB connection string for persistence, e.g. a free MongoDB Atlas cluster:
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/crochet-shop
MONGODB_URI=

# Password required to log into /admin on the site.
ADMIN_PASSWORD=changeme

# Any long random string, used to sign admin login sessions.
JWT_SECRET=replace-with-a-long-random-string

# Offline chat alert emails (nodemailer). For Gmail use smtp.gmail.com / 465 and an App Password (not your normal password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ALERT_TO=aishua782@gmail.com
ALERT_CC=suraj2468369@gmail.com
SITE_URL=
